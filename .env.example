PROJECT_NAME="MenoMate Core Backend"
DATABASE_URL="postgresql+asyncpg://postgres:your_password@localhost:5432/menomate"
# Supabase Project URL (Used for JWKS public key discovery and issuer verification)
SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_JWT_SECRET is optional when asymmetric signing (ES256/RS256) is used.
# It is only required if legacy symmetric HS256 signing is used.
# SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"
ALLOWED_ORIGINS="*"
AUTO_CREATE_TABLES="false"
